{
  // Cloudflare Workers config: the site is served as static assets, no Worker script.
  // Build step (Cloudflare "Build command" or `npm run build`) copies only the site files into dist/.
  "$schema": "https://developers.cloudflare.com/schemas/wrangler.json",
  "name": "itsm3abena-github-io",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  // Custom domains: the abenezer.dev zone must be on this Cloudflare account.
  // On deploy, Wrangler creates the DNS records and TLS certificates for these.
  "routes": [
    { "pattern": "abenezer.dev", "custom_domain": true },
    { "pattern": "www.abenezer.dev", "custom_domain": true }
  ]
}
